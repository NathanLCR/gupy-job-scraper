# SkillPulse AI - Production Environment Template
# Copy to .env in production and REPLACE ALL PLACEHOLDERS with real secrets.
# Validation will refuse to start if placeholders remain.

# Database Configuration (PostgreSQL 16 + pgvector required)
DATABASE_URL="postgresql://postgres:replace-with-db-password@db:5432/postgres"

# Redis & Rate Limiting
REDIS_URL="redis://replace-with-redis-host:6379/0"
RATE_LIMIT_ENABLED=true
RATE_LIMIT_SHADOW=false
RATE_LIMIT_KEY_SALT="replace-with-at-least-32-random-characters"
TRUSTED_PROXY_CIDRS="[]"
TRUST_CLOUDFLARE_CONNECTING_IP=false

# Rate Limits (Requests per minute per subject)
RATE_LIMIT_SEARCH_RPM=60
RATE_LIMIT_MATCH_RPM=20
RATE_LIMIT_EXPLAIN_RPM=5
RATE_LIMIT_EXTRACT_RPM=10

# Cloud AI Router
GROQ_API_KEY="replace-with-groq-api-key"
GROQ_MODEL="llama-3.3-70b-versatile"

OPENROUTER_API_KEY="replace-with-openrouter-api-key"
OPENROUTER_MODEL="meta-llama/llama-3.3-70b-instruct:free"

# Dense Embeddings (Cloudflare Workers AI is required in production)
EMBEDDING_PROVIDER="cloudflare"
CF_ACCOUNT_ID="replace-with-cloudflare-account-id"
CF_API_TOKEN="replace-with-cloudflare-api-token"
CF_EMBEDDING_MODEL="@cf/baai/bge-small-en-v1.5"
ACTIVE_EMBEDDING_MODEL="@cf/baai/bge-small-en-v1.5"
EMBEDDING_MODEL="sentence-transformers/all-MiniLM-L6-v2"
EMBEDDING_DIM=384
EMBEDDING_REEMBED_INTERVAL_SECONDS=900

# Keep disabled until migration 0012, search-document backfill, and active-model
# embedding coverage have been verified. Production startup enforces the gate.
POSTGRES_INDEXED_RETRIEVAL_ENABLED=false

# Batch Extraction Engine
EXTRACTION_BATCH_SIZE=15
EXTRACTION_RATE_LIMIT_DELAY=2.0
EXTRACTION_BACKOFF_SECONDS=2.0

# Admin & Operator Console Security (Spec 08)
ADMIN_API_KEY="replace-with-at-least-32-random-characters"
ADMIN_AUTH_ENABLED=true
ADMIN_SESSION_COOKIE="skillpulse_admin_session"

# App & Deployment
ENVIRONMENT="production"
DEBUG=false
PORT=8080
HOST="0.0.0.0"
CORS_ORIGINS=["https://skillpulse.pages.dev"]
