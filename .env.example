# SkillPulse AI - Example Environment Configuration
# Copy this file to .env and fill in your free API keys

# Database Configuration
DATABASE_URL="sqlite:///jobs.db"
# For Neon / Supabase PostgreSQL with pgvector:
# DATABASE_URL="postgresql://username:password@ep-xyz.neon.tech/neondb?sslmode=require"

# Cloud AI Router (Free Tiers)
GROQ_API_KEY="your-free-groq-api-key-here"
GROQ_MODEL="llama-3.3-70b-versatile"

OPENROUTER_API_KEY="your-free-openrouter-api-key-here"
OPENROUTER_MODEL="meta-llama/llama-3.3-70b-instruct:free"

# Dense Embeddings (In-Memory CPU SentenceTransformers)
EMBEDDING_MODEL="all-MiniLM-L6-v2"
EMBEDDING_DIM=384

# Batch Extraction Engine & Rate-Limit Settings
EXTRACTION_BATCH_SIZE=15
EXTRACTION_RATE_LIMIT_DELAY=2.0
EXTRACTION_BACKOFF_SECONDS=25

# App & Deployment
ENVIRONMENT="production"
PORT=8000
HOST="0.0.0.0"
CORS_ORIGINS=["https://skillpulse.pages.dev", "http://localhost:8000"]
