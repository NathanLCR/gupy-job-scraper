# SkillPulse AI - Local Development Configuration
# Copy this file to .env and adjust as needed

# Database Configuration
DATABASE_URL="sqlite:///jobs.db"
# For PostgreSQL with pgvector (local Docker):
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/postgres"

# Redis & Rate Limiting
REDIS_URL="redis://localhost:6379/0"
RATE_LIMIT_ENABLED=false
RATE_LIMIT_SHADOW=false
RATE_LIMIT_KEY_SALT="development-local-rate-limit-salt-minimum-32-chars"
TRUSTED_PROXY_CIDRS="[]"
TRUST_CLOUDFLARE_CONNECTING_IP=false

# Rate Limits (Requests per minute per client)
RATE_LIMIT_SEARCH_RPM=60
RATE_LIMIT_MATCH_RPM=20
RATE_LIMIT_EXPLAIN_RPM=5
RATE_LIMIT_EXTRACT_RPM=10

# Cloud AI Router (Free Tiers)
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"

OPENROUTER_API_KEY=""
OPENROUTER_MODEL="meta-llama/llama-3.3-70b-instruct:free"

# Dense Embeddings (In-Memory CPU SentenceTransformers)
EMBEDDING_PROVIDER="hash_dev_only"
ACTIVE_EMBEDDING_MODEL="hash-dev-v1"
EMBEDDING_MODEL="sentence-transformers/all-MiniLM-L6-v2"
EMBEDDING_DIM=384
POSTGRES_INDEXED_RETRIEVAL_ENABLED=false
EMBEDDING_REEMBED_INTERVAL_SECONDS=900

# Batch Extraction Engine
EXTRACTION_BATCH_SIZE=15
EXTRACTION_RATE_LIMIT_DELAY=2.0
EXTRACTION_BACKOFF_SECONDS=2.0

# Admin / Operator Security
ADMIN_API_KEY=""
ADMIN_AUTH_ENABLED=true

# App & Deployment
ENVIRONMENT="development"
DEBUG=true
PORT=8000
HOST="0.0.0.0"
CORS_ORIGINS=["http://localhost:8000", "http://127.0.0.1:8000"]
